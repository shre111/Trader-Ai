# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=postgres
DB_PASSWORD=postgres

# Zerodha Kite Connect
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=your_access_token

# TrueData
TRUEDATA_USER=your_truedata_username
TRUEDATA_PASSWORD=your_truedata_password

# Transaction costs (shared by both backtest engines)
# Half the bid/ask spread, paid on entry AND exit. 0.003 = 0.3% per side.
OPTION_HALF_SPREAD_PCT=0.003
COMMISSION_PER_ORDER=20.0

# Trading Parameters
INITIAL_CAPITAL=50000
RISK_PER_TRADE=0.01
MAX_TRADES_PER_DAY=5
MAX_DAILY_LOSS=0.05
SCORE_THRESHOLD=0.6

# Model
MODEL_DIR=models/saved
MACRO_MODEL_PATH=models/saved/macro_model.pkl
MICRO_MODEL_PATH=models/saved/micro_model.pkl

# Live price cache (written by collect_ticks.py, read by Flask)
# Defaults to <system temp>/td_live_prices.json — correct on macOS/Linux/Windows.
# Only set this if you need the file somewhere specific.
# LIVE_CACHE_FILE=

# API Security
# Host the Flask API binds to. Keep 127.0.0.1 unless you explicitly need LAN
# access — the API can reach a live broker.
BIND_HOST=127.0.0.1
# Comma-separated origins allowed to call the API from a browser.
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared secret required by /api/broker/* (real-money routes). If empty, those
# routes are disabled and return 503. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BROKER_API_TOKEN=

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
